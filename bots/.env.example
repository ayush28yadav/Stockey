# Bot Service Environment Configuration
# Copy to bots/.env and adjust as needed. All values shown are the defaults.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# Base URL of the Stockey API (with Docker Compose, use the service name).
API_ORIGIN=http://api:4000

# PostgreSQL connection string (for seeding bot accounts/holdings only).
DATABASE_URL=postgresql://stockey:stockey@postgres:5432/stockey

# Number of simultaneous bot instances.
BOT_COUNT=10

# Delay (ms) between each bot's order attempts.
TICK_INTERVAL_MS=500

# Maximum fractional distance from fair value for limit prices (0.005 = 0.5%).
PRICE_VARIANCE=0.005

# Probability (0..1) of placing a market order instead of a limit order.
MARKET_ORDER_PROBABILITY=0.2

# Comma-separated symbols the bots trade.
ENABLED_STOCKS=AAPL,RELIANCE,INFY

# Strategy: random-market-maker | trend-follower | mean-reverter | volume-bot | mixed
STRATEGY=mixed

# ---------------------------------------------------------------------------
# Bot account bootstrap
# ---------------------------------------------------------------------------
BOT_EMAIL_PREFIX=bot
BOT_PASSWORD=stockey-bot-password

# Initial cash balance granted to each bot account.
BOT_SEED_BALANCE=1000000

# Initial share holdings granted to each bot account per enabled symbol.
BOT_SEED_HOLDINGS=10000

# Average buy price recorded for seeded holdings (informational).
BOT_SEED_PRICE=100

# ---------------------------------------------------------------------------
# Order sizing
# ---------------------------------------------------------------------------
# Standard order quantity range for non-volume strategies.
MIN_ORDER_QUANTITY=1
MAX_ORDER_QUANTITY=50

# Volume Bot quantity range.
VOLUME_MIN_QUANTITY=100
VOLUME_MAX_QUANTITY=500

# Probability (0..1) that the Volume Bot places an order on any given tick.
VOLUME_ORDER_PROBABILITY=0.3

# ---------------------------------------------------------------------------
# Strategy tuning
# ---------------------------------------------------------------------------
# Fair value random-walk drift per tick (0.001 = 0.1%).
DRIFT_RATE=0.001

# Trend Follower parameters.
TREND_WINDOW=20
TREND_MIN_SAMPLES=5

# Mean Reverter parameters.
MEAN_WINDOW=30
MEAN_MIN_SAMPLES=5
MEAN_THRESHOLD=0.01

# How often (in ticks) each bot refreshes market data from the API.
MARKET_DATA_REFRESH_TICKS=10

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info