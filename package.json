{
  "name": "stockey",
  "private": true,
  "workspaces": [
    "api",
    "workers",
    "bots",
    "frontend"
  ],
  "scripts": {
    "setup:dev": "node scripts/setup-dev-env.mjs",
    "dev": "npm run dev --workspace=@stockey/api",
    "dev:api": "npm run dev --workspace=@stockey/api",
    "dev:frontend": "npm run dev --workspace=@stockey/frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:api": "docker compose exec -T api npm run test --workspace=@stockey/api"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
